PluginInterface, #view {
    border: none;
    background-color: transparent;
}

ScrollArea {
    background-color: transparent;
    border: none;
}

/* 左侧面板 - 透明背景 */
#left_panel {
    background-color: transparent;
    border-right: 1px solid rgba(200, 200, 205, 0.4);
}

/* 分割器 */
QSplitter::handle {
    background-color: rgba(200, 200, 205, 0.4);
}

QSplitter::handle:horizontal {
    width: 1px;
}

/* 插件列表卡片 - 亮色主题 */
PluginListCard {
    background-color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(220, 220, 225, 0.6);
    border-radius: 8px;
}

PluginListCard:hover {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(200, 200, 210, 0.8);
}

/* 插件卡片 - 亮色主题（自绘样式，QSS仅作参考） */
