PluginInterface, #view {
    border: none;
    background-color: transparent;
}

ScrollArea {
    background-color: transparent;
    border: none;
}

/* 左侧面板 - 透明背景 */
#left_panel {
    background-color: transparent;
    border-right: 1px solid rgba(200, 200, 205, 0.4);
}

/* 分割器 */
QSplitter::handle {
    background-color: rgba(200, 200, 205, 0.4);
}

QSplitter::handle:horizontal {
    width: 1px;
}
