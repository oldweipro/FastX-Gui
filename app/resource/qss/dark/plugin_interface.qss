PluginInterface, #view {
    border: none;
    background-color: transparent;
}

ScrollArea {
    border: none;
    background-color: transparent;
}

/* 左侧面板 - 透明背景 */
#left_panel {
    background-color: transparent;
    border-right: 1px solid rgba(70, 70, 75, 0.4);
}

/* 插件列表标题 */
#left_title {
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
}

/* 插件列表统计 */
#left_stats {
    color: #a0a0a5;
    font-size: 12px;
}

/* 分割器 */
QSplitter::handle {
    background-color: rgba(70, 70, 75, 0.4);
}

QSplitter::handle:horizontal {
    width: 1px;
}

/* 插件列表卡片 - 暗色主题（与底色更渐进融合） */
PluginListCard {
    background-color: rgba(50, 50, 54, 0.4);
    border: 1px solid rgba(70, 70, 75, 0.3);
    border-radius: 8px;
}

PluginListCard:hover {
    background-color: rgba(58, 58, 62, 0.6);
    border: 1px solid rgba(85, 85, 90, 0.5);
}

/* 插件列表卡片 - 字体颜色 */
PluginListCard StrongBodyLabel,
PluginListCard CaptionLabel {
    color: #ffffff;
}

/* 插件卡片 - 字体颜色 */
PluginCard StrongBodyLabel,
PluginCard BodyLabel,
PluginCard CaptionLabel {
    color: #ffffff;
}

/* 插件卡片内版本号颜色 */
PluginCard CaptionLabel#version_label {
    color: #4fc3f7;
}

/* 插件卡片内分类颜色 */
PluginCard CaptionLabel#category_label {
    color: #c0c0c5;
}

/* 插件卡片内描述颜色 */
PluginCard BodyLabel#desc_label {
    color: #d0d0d5;
}

/* 插件卡片内作者颜色 */
PluginCard CaptionLabel#author_label {
    color: #a0a0a5;
}

/* 工具栏搜索框 */
SearchLineEdit {
    color: #ffffff;
    background-color: rgba(45, 45, 48, 0.6);
    border: 1px solid rgba(80, 80, 85, 0.5);
}

SearchLineEdit:focus {
    border: 1px solid rgba(100, 100, 110, 0.7);
}

/* ComboBox */
ComboBox {
    color: #ffffff;
    background-color: rgba(45, 45, 48, 0.6);
    border: 1px solid rgba(80, 80, 85, 0.5);
}

ComboBox:hover {
    background-color: rgba(55, 55, 58, 0.7);
}

ComboBox:pressed {
    background-color: rgba(40, 40, 43, 0.8);
}

/* 统计标签 */
#left_stats,
CaptionLabel#stats_label {
    color: #b0b0b5;
}

/* 按钮提示文字 */
TransparentToolButton {
    color: #ffffff;
}

/* 分类标签 */
CaptionLabel#category_label {
    color: #c0c0c5;
}

/* 作者标签 */
CaptionLabel#author_label {
    color: #a0a0a5;
}
